generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../db.sqlite"
}

model office {
  id         String    @id @default(uuid())
  name       String
  logo_url   String
  location   String?
  created_at DateTime? @default(now())
  updated_at DateTime? @default(now())
}
