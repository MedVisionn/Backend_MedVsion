generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../db.sqlite"
}

model patient {
  id            String    @id @default(uuid())
  doctor_id     String
  first_name    String
  last_name     String
  gender        String?
  date_of_birth DateTime?
  phone         String?
  notes         String?
  created_at    DateTime? @default(now())
  updated_at    DateTime? @updatedAt
}